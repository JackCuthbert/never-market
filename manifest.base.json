{
  "manifest_version": 3,
  "name": "Never Market",
  "version": "0.1.0",
  "description": "Hides third-party marketplace listings on Big W, Bunnings, JB Hi-Fi, Kmart and Woolworths.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "minimum_chrome_version": "105",
  "browser_specific_settings": {
    "gecko": { "id": "never-market@jckcthbrt.io", "strict_min_version": "121.0" }
  }
}
